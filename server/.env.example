DATABASE_URL="file:./dev.db"
PORT=4000
# Set to "true" only if the app is served over HTTPS (reverse proxy with TLS) — a secure
# cookie is silently dropped by the browser over plain HTTP, which would break login.
COOKIE_SECURE=false
# AES-256-GCM key for encrypting crew compliance documents at rest (64 hex chars = 32 bytes).
# Generate one with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# and never commit the real value — crew document upload/download is unavailable without it.
CREW_DOC_ENCRYPTION_KEY=
