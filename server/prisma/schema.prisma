generator client {
  provider      = "prisma-client-js"
  // node:22-alpine ships OpenSSL 3.x only (no libssl.so.1.1) — without an explicit target
  // here, Prisma's engine defaults to the OpenSSL 1.1 build and crashes at runtime with a
  // non-JSON "Error loading shared library libssl.so.1.1" instead of a clean error.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Job {
  id          String   @id @default(cuid())
  name        String
  venue       String?
  /// Free-text description — the "What" review field at onboarding, editable afterward from
  /// Job Settings. Distinct from `name`: at import time `name` defaults to the Current RMS
  /// opportunity's subject, while this starts blank for the admin to fill in if they want one.
  description String?
  /// The actual postal address for this job's location — distinct from `venue` (a display
  /// name/label, often the customer's name as pulled from Current RMS). Drives the "Where"
  /// map preview and Maps-app deep links (see web/src/components/LocationLinks.tsx).
  address     String?
  /// Admin-set override of the job's start/end, reviewed at onboarding and editable afterward.
  /// Falls back to the linked Current RMS opportunity's own dates when null (see the "When"
  /// section on both the admin and crew job pages).
  startsAt    DateTime?
  endsAt      DateTime?
  logoPath    String?
  /// Visible to USER/SIGNAGE roles only when true; ADMIN always sees every job.
  isPublic    Boolean  @default(false)

  currentRmsOpportunityId  String?
  /// Set by the sync poller when the linked opportunity's updated_at moves forward;
  /// cleared (set to null) when a viewer acknowledges it. Null = no outstanding alert.
  rmsAlertAt               DateTime?
  /// Last-synced opportunity items (id/name/quantity), kept purely so the next sync can diff
  /// against it to detect what changed — not shown directly, see rmsItemsDiffJson.
  rmsItemsSnapshotJson     String?
  /// The most recently computed added/removed/quantity-changed diff versus the previous
  /// snapshot, for the signage full-screen change alert. Null = no outstanding items alert.
  rmsItemsDiffJson         String?
  rmsItemsDiffAt           DateTime?

  /// Set when onboarding matched (or an admin manually picked) a folder under the OneDrive
  /// "Projects" root for this job — see server/src/oneDrive/matcher.ts. Null until OneDrive is
  /// configured and linked; the whole feature stays optional per-job.
  oneDriveFolderId     String?
  oneDriveFolderPath   String?
  /// MATCHED (auto-matched by name at onboarding) | MANUAL (an admin picked it) | null (no
  /// OneDrive folder linked yet).
  oneDriveMatchStatus  String?
  /// Per-job override of which crew-portal sections are visible for this job's crew, merged
  /// onto the global default (see server/src/crewFeatures.ts). Null = use the default as-is;
  /// set at onboarding time, editable later from Job Settings.
  crewFeaturesJson     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fixtures       Fixture[]
  caseGroups     CaseGroupRecord[]
  adHocLabels    AdHocLabel[]
  printQueueItems PrintQueueItem[]
  plots          Plot[]
  locationColorRules LocationColorRule[]
  pickListItemStatuses PickListItemStatus[]
  labelTemplates LabelTemplate[]
  crewAssignments JobCrewAssignment[]
  scheduleItems  JobScheduleItem[]
  documents      JobDocument[]
  labelRequests  CrewLabelRequest[]
  discussionMessages JobDiscussionMessage[]
  oneDriveShares OneDriveShare[]
  patchImportCandidate PatchImportCandidate?
  linkedRmsOpportunities JobLinkedRmsOpportunity[]
}

/// A OneDrive file or folder an admin has explicitly chosen to share with this job's crew —
/// deliberately opt-in (no blanket "crew sees everything in the matched folder") since a
/// project folder can hold client-sensitive files crew shouldn't see. The one exception is the
/// "CAD" folder's first PDF, which the crew job page surfaces automatically (see
/// server/src/oneDrive/cad.ts) — that's a convenience, not a security boundary, since CAD plans
/// are expected to be crew-visible by default.
model OneDriveShare {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// The Microsoft Graph driveItem id of the shared file or folder.
  itemId       String
  itemName     String
  itemPath     String
  isFolder     Boolean
  /// Admin-flagged alongside sharing: this shared item is one of the job's CAD plots, so it's
  /// grouped with the rest of the CAD set (uploaded Plot PDFs + the auto-detected one) instead of
  /// the generic "Shared with crew" list — see CadPlotsViewer on the web side.
  isCadPlot    Boolean  @default(false)
  sharedAt     DateTime @default(now())
  sharedByUserId String?

  @@unique([jobId, itemId])
  @@index([jobId])
}

/// A flat, chronological message thread scoped to one job — like a channel for that gig.
/// Visible/postable by any ADMIN/USER staff account and by crew assigned to the job (see
/// routes/jobDiscussion.ts for staff, routes/crewPortal.ts's /me/jobs/:jobId/discussion for
/// crew — two route surfaces over the same table, matching how schedule/documents/kit-list
/// already work). No edit/delete yet — admin moderation is a later milestone.
model JobDiscussionMessage {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorUserId String
  authorUser   User     @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  body         String
  createdAt    DateTime @default(now())

  @@index([jobId])
}

/// One timed entry in a job's day schedule (load-in, soundcheck, doors, show, get-out, ...) —
/// the crew job page's "Why" section renders these as a Google-Calendar-style day timeline.
/// Admin-managed from the job detail page's Schedule tab; crew get read-only access through
/// the crew portal. Deliberately its own small model rather than a document upload, so it can
/// actually be rendered as a timeline instead of just linking to a PDF.
model JobScheduleItem {
  id        String    @id @default(cuid())
  jobId     String
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title     String
  startsAt  DateTime
  endsAt    DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([jobId])
}

/// General job files (call sheets, info packs, contracts) — unencrypted like Plot, since
/// nothing here is the compliance-sensitive personal data CrewDocument protects. Admin-managed
/// from the job detail page; crew get read-only access to their assigned jobs' documents.
model JobDocument {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  originalName String
  fileName     String
  mimeType     String
  createdAt    DateTime @default(now())

  @@index([jobId])
}

/// A freelance crew member's profile — 1:1 with a User whose role is CREW. For now the only
/// way one of these pairs comes into existence is an admin creating both together on the Crew
/// settings page (see routes/crew.ts); the public application flow (a later milestone) will be
/// the second path, via CrewApplication approval instead. Compliance documents (right-to-work,
/// insurance, bank details) are deliberately not modeled here yet — that needs the encrypted
/// storage a later milestone builds; this is just contact/professional info for attribution.
model CrewProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  /// Admin-set hex swatch color (e.g. "#1E88E5") shown next to this crew member on the
  /// schedule calendar popup, so staff can tell who's on which job at a glance. Null = use the
  /// stable id-derived default from shared/src/crewColors.ts rather than a fixed neutral —
  /// unlike LocationColorRule's fallback, every crew member should look visually distinct even
  /// with zero admin setup.
  color     String?
  /// Free-text list of roles/skills (e.g. "LD, Rigger, Spot Op") — a simple string for now
  /// rather than a separate taxonomy table, since nothing queries or filters by skill yet.
  skills    String?
  /// Same comma-separated-string convention as skills (see shared/src/crewCertifications.ts).
  certifications String?
  /// Default day rate as a plain string (e.g. "250.00") rather than a typed money column —
  /// nothing does arithmetic on it yet; a future Xero integration can introduce real currency
  /// handling once it actually moves money (see xeroContactId on JobCrewAssignment).
  dayRate   String?
  notes     String?
  gender    String?
  address   String?
  pronouns  String?
  instagramUrl String?
  facebookUrl  String?
  otherLinkUrl String?
  /// Bank details, structured (not a file) but still encrypted at rest with the same AES-256-GCM
  /// scheme as CrewDocument (see crewDocCrypto.ts) — ciphertext is the JSON-stringified field set
  /// ({accountName, sortCode, accountNumber, bankName}), base64-encoded. Never returned in a list
  /// response; a dedicated admin-only route decrypts it on request, same posture as documents.
  bankDetailsCiphertext String?
  bankDetailsIv         String?
  bankDetailsAuthTag    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments JobCrewAssignment[]
  documents   CrewDocument[]
  labelRequests CrewLabelRequest[]
  requestedAdHocLabels AdHocLabel[]
  rateLines   CrewRateLine[]
}

/// A named rate line on a crew member's rate card (e.g. "Day rate", "Overtime", "Travel day") —
/// replaces the single free-text CrewProfile.dayRate in the UI, which stays in the schema
/// unmodified for any historical record that already used it. amount is a plain string like
/// dayRate (see its own comment) — no arithmetic happens on it, no currency type needed yet.
model CrewRateLine {
  id            String      @id @default(cuid())
  crewProfileId String
  crewProfile   CrewProfile @relation(fields: [crewProfileId], references: [id], onDelete: Cascade)
  label         String
  amount        String
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([crewProfileId])
}

/// A public, unauthenticated submission to join the freelance crew roster — deliberately has
/// no User row until an admin approves it (see routes/crewApplications.ts): there is nothing to
/// log into before approval, not just a status flag that happens to be checked. rightToWork is
/// the applicant's own free-text statement, not a substitute for the actual document (see
/// CrewDocument) — this model holds only the form fields.
model CrewApplication {
  id            String    @id @default(cuid())
  fullName      String
  email         String
  phone         String?
  skills        String?
  certifications String?
  dayRate       String?
  rightToWork   String?
  notes         String?
  gender        String?
  address       String?
  /// See CrewProfile.bankDetailsCiphertext — same scheme, copied across to the CrewProfile on
  /// approval (routes/crewApplications.ts) rather than re-encrypted.
  bankDetailsCiphertext String?
  bankDetailsIv         String?
  bankDetailsAuthTag    String?
  /// PENDING | APPROVED | REJECTED
  status        String    @default("PENDING")
  reviewedAt    DateTime?
  reviewedBy    String?
  rejectionNote String?
  createdAt     DateTime  @default(now())

  documents CrewDocument[]

  @@index([status])
}

/// The lighter-weight intake path for people we already want on the roster and don't need to
/// run through the full CrewApplication review — just a name, reviewed, then a signup link.
/// Approval here only decides "do we want this person at all"; the invitee then completes their
/// own profile (bank details, skills, etc.) via a one-time token link, rather than an admin
/// filling it in on their behalf. token is null until approved (nothing to visit before then).
model OnboardingInvite {
  id         String    @id @default(cuid())
  fullName   String
  token      String?   @unique
  /// PENDING | APPROVED | REJECTED | COMPLETED
  status     String    @default("PENDING")
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime  @default(now())

  @@index([status])
}

/// Encrypted compliance documents (right-to-work, insurance, bank details, ID) — see
/// server/src/crewDocCrypto.ts for the AES-256-GCM scheme (key from CREW_DOC_ENCRYPTION_KEY).
/// Attached to a CrewApplication while it's pending, or to a CrewProfile once approved (exactly
/// one of the two FKs is set at a time — approval moves the rows over, see
/// routes/crewApplications.ts). Served only through a dedicated decrypt-and-stream route, never
/// res.sendFile; every read is logged via the existing ActivityLogEntry (see plan: no new audit
/// table needed for v1). expiresAt is modeled but nothing acts on it yet — automated
/// retention/deletion is a policy decision for later, not a technical one.
model CrewDocument {
  id            String           @id @default(cuid())
  applicationId String?
  application   CrewApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  crewProfileId String?
  crewProfile   CrewProfile?     @relation(fields: [crewProfileId], references: [id], onDelete: Cascade)
  /// RIGHT_TO_WORK | INSURANCE | BANK_DETAILS | ID | OTHER
  kind          String
  originalName  String
  /// On-disk filename under uploads/crew-documents/ — content is ciphertext, never plaintext.
  fileName      String
  mimeType      String
  /// Base64 AES-GCM IV and auth tag, needed alongside the key to decrypt.
  iv            String
  authTag       String
  expiresAt     DateTime?
  createdAt     DateTime         @default(now())

  @@index([applicationId])
  @@index([crewProfileId])
}

/// Attributes a crew member to a job: their role on that job, plus an optional per-job
/// day-rate override (falls back to the profile's default dayRate when unset). xeroContactId
/// is a nullable placeholder for a later Xero integration — no payment processing happens here.
model JobCrewAssignment {
  id            String      @id @default(cuid())
  jobId         String
  job           Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  crewProfileId String
  crewProfile   CrewProfile @relation(fields: [crewProfileId], references: [id], onDelete: Cascade)
  role          String
  dayRate       String?
  /// How many days this assignment is booked for on this job — multiplied by dayRate (or the
  /// profile's default) to get this assignment's cost, for the admin-only crew margin view
  /// (routes/currentRms.ts's /crew-margin). Null is treated as 1 day, so existing assignments
  /// made before this field existed still cost out sensibly.
  days          String?
  /// Explicitly costs this assignment at zero regardless of dayRate/profile/global defaults —
  /// distinct from just leaving dayRate blank (which means "use the default", not "free"), for
  /// e.g. zero-rating an owner/business partner out of the margin calculation.
  zeroRated     Boolean     @default(false)
  xeroContactId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([jobId, crewProfileId])
  @@index([jobId])
  @@index([crewProfileId])
}

/// Per-job override of a label type's default layout (see @elexprep/shared's
/// DEFAULT_LABEL_TEMPLATES/mergeTemplate) — not read by anything yet; the print-queue
/// interactive editor (a later milestone) will be the first writer/reader. elementsJson is a
/// partial, per-element-id patch (Record<elementId, Partial<LabelElementDef>>), merged onto
/// the matching default template at render time — never a whole-template replacement, so a
/// new default element introduced later still reaches jobs that already customized this type.
model LabelTemplate {
  id            String   @id @default(cuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  labelType     String
  elementsJson  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([jobId, labelType])
  @@index([jobId])
}

/// Tracks each Current RMS opportunity item's local crew-prep state ("pulled"/"booked out")
/// for a job's signage pick list — independent of whatever Current RMS's own line-item status
/// says, since that's ElexPrep's own added value for prep-bay tracking. Keyed on the job plus
/// the CRMS item's stable id so a sync refresh doesn't reset progress crew has already ticked off.
model PickListItemStatus {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rmsItemId Int
  prepped   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([jobId, rmsItemId])
  @@index([jobId])
}

model FixtureTypeRule {
  id                 String   @id @default(cuid())
  name               String   @unique
  unitsPerCase       Int      @default(1)
  caseLabelOverride  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Maps a stage location string (as it appears in the patch/ad hoc "location" field) to a
/// hex color for the PAL label's location bar. Matched case-insensitively; a location with
/// no rule falls back to a neutral default color at render time. jobId null = a global
/// default rule; jobId set = a per-job override/addition (for jobs whose patch uses location
/// names that don't match the house defaults) that takes precedence for that job only.
/// Uniqueness of (jobId, location) is enforced at the application layer rather than a DB
/// constraint, since SQLite/Prisma's composite unique treats every NULL jobId as distinct.
model LocationColorRule {
  id        String   @id @default(cuid())
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  location  String
  color     String
  /// "SOLID" (default), "DIAGONAL_STRIPES" for hazard-tape-style locations (e.g. Spare, Rigging),
  /// or "RAINBOW" for a fixed multi-color band (the "Everywhere" location, for items not tied
  /// to one specific spot) - RAINBOW ignores `color`/`secondaryColor` entirely.
  pattern        String  @default("SOLID")
  /// Second stripe color, only used when pattern is DIAGONAL_STRIPES.
  secondaryColor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
}

model Fixture {
  id            String  @id @default(cuid())
  jobId         String
  job           Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  address       Int
  fixtureType   String
  mainUniverse  Int?
  mainAddress   Int?
  pixUniverse   Int?
  pixAddress    Int?
  mode          String?
  location      String?
  ipAddress     String?
  subnetMask    String?
  notes         String?
  rawJson       String?

  @@index([jobId])
}

/// A patch CSV auto-detected in a job's OneDrive "Patch" subfolder, parsed and held for admin
/// review before being applied — unlike the CAD plot (auto-surfaced read-only, see
/// oneDrive/cad.ts), importing patch data destructively replaces every Fixture row for the job
/// (see routes/patch.ts), so it needs an explicit approval step rather than a silent auto-apply.
/// One row per job: a re-scan that finds the same file (by sourceModifiedAt) leaves this record
/// alone; a re-scan that finds a changed or new file overwrites it back to PENDING, even if the
/// previous one had already been approved or rejected.
model PatchImportCandidate {
  id               String    @id @default(cuid())
  jobId            String    @unique
  job              Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  oneDriveItemId   String
  oneDriveItemPath String
  fileName         String
  /// csv | pdf — csv means an exported patch CSV (reliable); pdf means the rows were lifted
  /// from the job's CAD PDF via fuzzy table/text extraction (routes/patch.ts's fallback when no
  /// CSV is found) and deserve extra scrutiny before approval. See oneDrive/patchPdfExtract.ts.
  extractedFrom    String    @default("csv")
  /// Graph's lastModifiedDateTime for the source file, used to tell "this is the same file
  /// already flagged" from "it changed since" without re-parsing on every scan.
  sourceModifiedAt DateTime
  /// Parsed rows (header -> cell), ready to run back through the saved column mapping at
  /// approval time — same shape /patch/preview returns for the manual upload flow.
  rowsJson         String
  /// PENDING | APPROVED | REJECTED
  status           String    @default("PENDING")
  detectedAt       DateTime  @default(now())
  reviewedAt       DateTime?
  reviewedBy       String?
  rejectionNote    String?
}

/// A generated case grouping (e.g. "AstraBlade 201 + 202"). Regenerated whenever the
/// packing algorithm re-runs for a job; addressesJson holds the member fixture addresses.
model CaseGroupRecord {
  id            String  @id @default(cuid())
  jobId         String
  job           Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fixtureType   String
  label         String
  location      String?
  addressesJson String

  @@index([jobId])
}

/// labelType is one of: FIXTURE, TRUSS_SPIKE_POSITION, TRUSS_SPIKE_TIP, TRUSS_SPIKE_SACN,
/// CABLE, PAL, RACK (see @elexprep/shared LabelType). SQLite has no native enum type, so
/// this is validated at the application layer instead of the database layer.
/// Manually-added labels that don't come from the patch (personal Peli cases, generic
/// equipment cases like "Hazer" or "Powercube", spare cable labels, etc).
model AdHocLabel {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  labelType   String
  contentJson String
  quantity    Int       @default(1)
  /// Print-run position, shared with PrintQueueItem's `order` across the same
  /// (jobId, labelType) group — determines which physical cell a copy lands in.
  order       Int       @default(0)
  /// Skips this ad hoc label for the next print run without deleting the label recipe
  /// itself (which stays editable/reusable in the Labels tab).
  excludeFromPrint Boolean @default(false)
  /// Set when this label was created by approving a CrewLabelRequest — lets the Labels tab
  /// show "requested by <crew member>" provenance. SetNull (not Cascade) so deleting the crew
  /// member later doesn't delete labels already approved onto the sheet.
  requestedByCrewProfileId String?
  requestedByCrewProfile   CrewProfile? @relation(fields: [requestedByCrewProfileId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

/// A crew member's request for an extra/replacement label, built with the same type + content
/// fields as the admin's ad hoc label creator (see web's LabelTypeForm, shared by both). Sits
/// in PENDING until an admin/staff member approves (creating the real AdHocLabel, attributed
/// back to the requester) or rejects it — never lands in the print queue directly.
model CrewLabelRequest {
  id            String      @id @default(cuid())
  jobId         String
  job           Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  crewProfileId String
  crewProfile   CrewProfile @relation(fields: [crewProfileId], references: [id], onDelete: Cascade)
  labelType     String
  contentJson   String
  quantity      Int         @default(1)
  /// PENDING | APPROVED | REJECTED
  status        String      @default("PENDING")
  reviewedAt    DateTime?
  reviewedBy    String?
  rejectionNote String?
  createdAt     DateTime    @default(now())

  @@index([jobId])
  @@index([status])
}

/// status is one of: PENDING, CONFIRMED, PRINTED (see @elexprep/shared PrintQueueStatus).
model PrintQueueItem {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  labelType   String
  sourceType  String
  sourceId    String?
  contentJson String
  quantity    Int      @default(1)
  status      String   @default("PENDING")
  /// Print-run position, shared with AdHocLabel's `order` across the same
  /// (jobId, labelType) group — determines which physical cell a copy lands in.
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobId])
}

/// ipAddress/userAgent are filled in automatically by logActivity() from the current
/// request's AsyncLocalStorage context (see server/src/requestContext.ts) — every call site
/// gets them for free, including auth.login/auth.login_failed, without having to thread req
/// through 80+ existing logActivity() calls. Null only for entries raised outside an HTTP
/// request (the Current RMS poll timer, etc.).
model ActivityLogEntry {
  id        String   @id @default(cuid())
  jobId     String?
  userId    String?
  action    String
  detail    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

/// Free-form key/value app settings, e.g. key "patchMapping" holding the saved CSV
/// column mapping so imports don't re-prompt for it every time.
model AppSetting {
  key       String   @id
  valueJson String
  updatedAt DateTime @updatedAt
}

/// role is one of: ADMIN, USER, SIGNAGE, CREW (signage = read-only login for prep bay TVs;
/// crew = a freelancer's portal login, see CrewProfile — created only via routes/crew.ts,
/// never through the generic /api/users endpoint, so a CREW user always has a profile).
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String
  passwordHash String
  role         String    @default("USER")
  prefsJson    String    @default("{}")
  /// Per-user override of the role-level permissions baseline (see permissions.ts's
  /// loadRolePermissions/PERMISSION_KEYS) — null means "use the shared USER-role baseline
  /// unmodified", same posture as JobCrewAssignment.dayRate falling back to CrewProfile.dayRate.
  /// Only meaningful for USER-role accounts; ADMIN/SIGNAGE permissions are fixed regardless.
  permissionsJson String?

  /// TOTP second factor (RFC 6238), self-service and opt-in for any role — see
  /// server/src/totp.ts and routes/twoFactor.ts. The secret is encrypted at rest with the
  /// same AES-256-GCM helper as crew documents/bank details (crewDocCrypto.ts), never stored
  /// or returned in plaintext once confirmed. totpEnabled is false (and the secret columns
  /// null) until the user has proven they can generate a valid code for it.
  totpSecretCiphertext String?
  totpSecretIv          String?
  totpSecretAuthTag     String?
  totpEnabled            Boolean   @default(false)
  totpVerifiedAt         DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  crewProfile  CrewProfile?
  notifications Notification[]
  jobDiscussionMessages JobDiscussionMessage[]
  backupCodes  BackupCode[]
}

/// One-time recovery codes for when a 2FA-enabled user loses their authenticator — bcrypt-
/// hashed the same way passwords are (never stored in plaintext), each usable exactly once.
/// Generated 10 at a time whenever 2FA is enabled or codes are regenerated; the plaintext is
/// returned to the client exactly once, at generation time, and never again.
model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// In-app notifications v1 — deliberately a handful of trigger points (see
/// server/src/notifications.ts), not a general event bus: a crew application submitted, a
/// label request submitted, a crew member assigned to a job, and a label request reviewed.
/// link is a relative client-side path to navigate to on click (e.g. "/settings/crew-applications").
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, readAt])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A physical print job: one PDF destined for one tray. status is one of:
/// QUEUED (waiting for dispatch/agent), CLAIMED (agent picked it up), SENT (sent to the
/// printer or completed dry-run), DONE (agent confirmed), FAILED, CANCELLED.
model PrintJob {
  id        String   @id @default(cuid())
  jobId     String
  labelType String
  tray      String
  fileName  String
  method    String
  status    String   @default("QUEUED")
  error     String?
  pages     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Plot {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fileName     String
  originalName String
  createdAt    DateTime @default(now())

  @@index([jobId])
}

/// Local cache of Current RMS opportunities, refreshed by the poller (or a manual sync).
/// Kept separate from Job so browsing/searching all opportunities never has to hit the
/// live API, and stays fast under Current RMS's 60-req/60s rate limit. rawJson holds the
/// full API response for a given opportunity — field extraction below is a best-effort
/// read of the documented conventions, to be verified against a real account once linked;
/// raw data is never discarded even if a specific field turns out to be named differently.
/// An explicit, admin-set link from a job to another Current RMS opportunity whose charges
/// should count toward this job's crew margin — e.g. a separate "<Job> - Crewing" opportunity
/// that isn't itself worth putting on the portal as a job. Additive to the automatic
/// same-projectId sibling detection in routes/currentRms.ts's /crew-margin (a job can have
/// both, and the margin calc de-dupes by rmsId): that detection only catches opportunities
/// Current RMS itself grouped under one Project, while this covers cases where the two
/// opportunities were created without a shared Project and need a human to say "these go
/// together."
model JobLinkedRmsOpportunity {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rmsId     Int
  /// Cached at link time purely for display before the next Current RMS sync populates
  /// CurrentRmsOpportunity locally — not kept in sync afterward.
  subject   String?
  createdAt DateTime @default(now())

  @@unique([jobId, rmsId])
}

model CurrentRmsOpportunity {
  id           String    @id @default(cuid())
  rmsId        Int       @unique
  subject      String
  status       String?
  /// Best-effort classification of status/state into QUOTE | ORDER | OTHER, for the jobs
  /// onboarding dashboard's color coding (see extractKind in sync.ts) — Current RMS's own
  /// status taxonomy varies by account, so this is a heuristic read of the *_name fields,
  /// not a guaranteed-accurate opportunity-type field.
  kind         String?
  memberName   String?
  /// Best-effort order value, extracted from whichever total/charge field the raw response
  /// actually carries (see extractValue in sync.ts) — field naming hasn't been verified
  /// against a real account's /opportunities response, so this can be null even when the
  /// opportunity does have a value Current RMS just doesn't expose in a field we recognize yet.
  value        Float?
  /// Current RMS's own "Project" id (verified against a real account), which groups several
  /// opportunities together — e.g. a job's main rental opportunity plus a separate "<Job> -
  /// Crewing" opportunity for its labour. Used by the admin-only crew margin view
  /// (routes/currentRms.ts's /crew-margin) to sum crew charges across every opportunity
  /// sharing this job's project, not just the one it's directly linked to.
  projectId    Int?
  startsAt     DateTime?
  endsAt       DateTime?
  rmsUpdatedAt DateTime?
  rawJson      String
  syncedAt     DateTime  @updatedAt

  @@index([rmsId])
  @@index([projectId])
}
