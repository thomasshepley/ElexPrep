# Local agent/skill tooling (installed via `npx skills add`), not project code — but
# .claude/settings.json itself IS committed (see below): it's what lets a cloud session's
# permissions.allow rules actually take effect, which requires the file to be in the repo.
.agents/
.claude/*
!.claude/settings.json
skills-lock.json

# Windows print agent's real config (holds the agent token) and its log directory
agent/agent-config.json
agent/logs/

# Requests and progress for updates from the Webmaster page (scripts/update-agent.sh).
/data/ops/
server/ops/

# Maintenance mode switch and note (scripts/maintenance.sh) - state on the server, not code.
deploy/maintenance/ON
deploy/maintenance/message.txt
